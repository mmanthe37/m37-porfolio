---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource-variable/dm-sans';
import '../styles/site.css';
import { path, profile, nav } from '../lib/site';
interface Props { title: string; description: string; section: string; route: string; }
const { title, description, section, route } = Astro.props;
const canonical = new URL(path(route), Astro.site);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | Michael Manthe Jr.</title><meta name="description" content={description}/>
<link rel="canonical" href={canonical}/><link rel="icon" href={path('images/mark.png')}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title + ' | M37 Development'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(path('images/share.jpg'),Astro.site)}/><meta name="twitter:card" content="summary_large_image"/>
</head><body><a class="skip" href="#main">Skip to content</a>
<header class="wrap mast"><a class="brand" href={path()} aria-label="M37 Development home"><b>M37<span>.</span></b><span>Development</span></a>
<nav aria-label="Main navigation">{nav.map(([label,route])=><a href={path(route)} aria-current={section===label?'location':undefined}>{label}</a>)}</nav></header>
<main class="wrap" id="main"><slot/></main>
<footer class="wrap"><div><a class="brand" href={path()}><b>M37<span>.</span></b><span>Development</span></a><small>Michael Manthe Jr. · Central Florida</small></div><div class="footlinks">{profile.profiles.map(p=><a href={p.url}>{p.label} ↗</a>)}<a href={path('contact/')}>Contact →</a></div></footer>
</body></html>
